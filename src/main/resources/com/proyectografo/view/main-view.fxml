<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.proyectografo.controller.MainController"
            prefWidth="1100"
            prefHeight="720">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="barra-superior">

            <VBox spacing="4">
                <Label text="Proyecto de Grafos"
                       styleClass="titulo-aplicacion"/>

                <Label text="Grafos dirigidos · Matrices · Recorridos"
                       styleClass="subtitulo-aplicacion"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Lista y recorridos"
                    onAction="#mostrarResultados"
                    styleClass="boton-menu"/>

            <Button text="Menú principal"
                    onAction="#volverAlMenu"
                    styleClass="boton-menu"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contenido"
                   styleClass="panel-contenido">
            <BorderPane.margin>
                <Insets top="24"
                        right="24"
                        bottom="24"
                        left="24"/>
            </BorderPane.margin>
        </StackPane>
    </center>

    <bottom>
        <Label text="Conexiones dirigidas | Pesos enteros positivos | 0 en la matriz = sin conexión"
               styleClass="pie-aplicacion"/>
    </bottom>

</BorderPane>