<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectografo.controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="barra-superior">

            <VBox spacing="4">
                <Label styleClass="titulo-aplicacion" text="Laboratorio de Grafos" />

                <Label styleClass="subtitulo-aplicacion" text="By: Ismael, Anthony y Arleth" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#mostrarResultados" styleClass="boton-menu" text="Lista y recorridos" />

            <Button onAction="#volverAlMenu" styleClass="boton-menu" text="Menú principal" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contenido" styleClass="panel-contenido">
            <BorderPane.margin>
                <Insets bottom="24" left="24" right="24" top="24" />
            </BorderPane.margin>
        </StackPane>
    </center>

    <bottom>
        <Label styleClass="pie-aplicacion" text="Conexiones dirigidas | Pesos enteros positivos | 0 en la matriz = sin conexión" />
    </bottom>

</BorderPane>
