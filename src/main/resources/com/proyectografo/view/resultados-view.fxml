<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.proyectografo.controller.ResultadosController"
      spacing="12"
      prefHeight="400.0"
      prefWidth="600.0"
      style="-fx-padding: 20;">

    <Label text="Lista de adyacencia y recorridos"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextArea fx:id="listaAdyacenciaArea"
              editable="false"
              wrapText="true"
              prefRowCount="10"
              promptText="El grafo no tiene nodos."
              VBox.vgrow="ALWAYS"/>

    <HBox spacing="10">
        <Label text="Nodo inicial:"/>
        <ComboBox fx:id="nodoInicialCombo"
                  promptText="Selecciona un nodo"/>
    </HBox>

    <Button text="Ejecutar BFS"
            onAction="#ejecutarBFS"/>

    <Button text="Ejecutar DFS"
            onAction="#ejecutarDFS"/>

    <Label fx:id="recorridoLabel"
           text="Recorrido: —"
           wrapText="true"/>

</VBox>