<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proyectografo.controller.MatrizController"
            prefWidth="900"
            prefHeight="600">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <Label text="Editor de matriz de adyacencia"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Cantidad de nodos:"/>

                <TextField fx:id="cantidadNodosField"
                           promptText="Ejemplo: 3"
                           prefWidth="100"/>

                <Button text="Generar matriz"
                        onAction="#generarMatriz"/>

                <Button text="Convertir a grafo"
                        onAction="#convertirAGrafo"/>
            </HBox>

            <Label text="Filas = origen. Columnas = destino. 0 = sin conexión."
                   wrapText="true"/>

            <Label text="Ingrese pesos enteros positivos. La diagonal permanece en cero."
                   wrapText="true"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="false"
                    fitToHeight="false">

            <content>
                <GridPane fx:id="matrizGrid"
                          hgap="6"
                          vgap="6">

                    <padding>
                        <Insets top="15"
                                right="15"
                                bottom="15"
                                left="15"/>
                    </padding>
                </GridPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="estadoLabel"
               text="Digite la cantidad de nodos para comenzar."
               wrapText="true">

            <padding>
                <Insets top="12"
                        right="15"
                        bottom="12"
                        left="15"/>
            </padding>
        </Label>
    </bottom>

</BorderPane>